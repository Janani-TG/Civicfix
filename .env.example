# CivicFix Server Environment Configuration
PORT=3000

# Fast2SMS OTP Configuration (https://www.fast2sms.com)
# Option A: Quick OTP (No template required, easiest)
FAST2SMS_API_KEY=your_fast2sms_authorization_key_here

# Option B: Dedicated OTP Template (From /dev/otp/send)
# FAST2SMS_OTP_ID=your_otp_template_id_here

# 2Factor.in Configuration (Optional)
# TWO_FACTOR_API_KEY=your_2factor_api_key_here

# Google Gemini API Key for AI Resolution Verification
GEMINI_API_KEY=your_gemini_api_key_here

# SMTP Email Configuration (Optional - for real outbound email OTP dispatch)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your_email@gmail.com
# SMTP_PASS=your_app_password
# SMTP_FROM="CivicFix Portal" <noreply@civicfix.org>

